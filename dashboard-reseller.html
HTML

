<script>
// AUTH CHECK
const session = localStorage.getItem('ibaad_session');
if (!session) window.location.href = 'dashboard-login.html';


// State
let allResellers = [];
let filteredResellers = [];
let currentFilter = 'all';
let searchQuery = '';


// Load Data
async function loadResellers() {
    try {
        // Wait Firebase
        let attempts = 0;
        while ((!window.firebase || !window.firebase.ready) && attempts < 20) {
            await new Promise(r => setTimeout(r, 200));
            attempts++;
        }
        
        const { db, collection, getDocs } = window.firebase;
        const snapshot = await getDocs(collection(db, 'resellers'));
        
        allResellers = [];
        snapshot.forEach(docSnap => {
            allResellers.push({ id: docSnap.id, ...docSnap.data() });
        });
        
        // Sort by timestamp desc
        allResellers.sort((a, b) => {
            const t1 = a.timestamp?.toDate?.().getTime() || 0;
            const t2 = b.timestamp?.toDate?.().getTime() || 0;
            return t2 - t1;
        });
        
        updateCounts();
        applyFilters();
        
    } catch (error) {
        console.error('Load error:', error);
        document.getElementById('resellerGrid').innerHTML = `
            <div class="empty-state">
                <i class="fas fa-exclamation-triangle" style="color:#e74c3c;"></i>
                <h3>Gagal Memuat Data</h3>
                <p>${error.message}</p>
            </div>
        `;
    }
}


// Update Filter Counts
function updateCounts() {
    document.getElementById('countAll').textContent = allResellers.length;
    document.getElementById('countPending').textContent = allResellers.filter(r => r.status === 'pending').length;
    document.getElementById('countActive').textContent = allResellers.filter(r => r.status === 'active').length;
    document.getElementById('countInactive').textContent = allResellers.filter(r => r.status === 'inactive').length;
    document.getElementById('countRejected').textContent = allResellers.filter(r => r.status === 'rejected').length;
    document.getElementById('totalCount').textContent = allResellers.length;
}


// Apply Filters + Search
function applyFilters() {
    // Filter by status
    let result = currentFilter === 'all' 
        ? [...allResellers] 
        : allResellers.filter(r => r.status === currentFilter);
    
    // Search
    if (searchQuery) {
        const q = searchQuery.toLowerCase();
        result = result.filter(r => 
            (r.nama || '').toLowerCase().includes(q) ||
            (r.resellerCode || '').toLowerCase().includes(q) ||
            (r.wa || '').toLowerCase().includes(q) ||
            (r.email || '').toLowerCase().includes(q)
        );
    }
    
    filteredResellers = result;
    document.getElementById('visibleCount').textContent = result.length;
    renderResellers(result);
}


// Render Resellers
function renderResellers(resellers) {
    const grid = document.getElementById('resellerGrid');
    
    if (resellers.length === 0) {
        grid.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h3>Tidak Ada Data</h3>
                <p>${searchQuery ? 'Tidak ada reseller yang cocok dengan pencarian' : 'Belum ada reseller di kategori ini'}</p>
            </div>
        `;
        return;
    }
    
    let html = '';
    resellers.forEach(data => {
        const initial = (data.nama || '?').charAt(0).toUpperCase();
        const status = data.status || 'pending';
        
        // Format tanggal
        let dateStr = '-';
        if (data.timestamp?.toDate) {
            const date = data.timestamp.toDate();
            dateStr = date.toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'});
        }
        
        const dataStr = JSON.stringify({
            id: data.id,
            nama: data.nama || 'Tanpa Nama',
            wa: data.wa || '',
            resellerCode: data.resellerCode || '-'
        }).replace(/"/g, '&quot;');
        
        // Buttons based on status
        let buttons = '';
        if (status === 'pending') {
            buttons = `
                <button class="card-btn approve" onclick='handleApprove(${dataStr})'><i class="fas fa-check"></i>Approve</button>
                <button class="card-btn edit" onclick='handleEdit(${dataStr})'><i class="fas fa-edit"></i>Edit</button>
                <button class="card-btn reject" onclick='handleReject(${dataStr})'><i class="fas fa-times"></i>Reject</button>
            `;
        } else if (status === 'active') {
            buttons = `
                <button class="card-btn detail" onclick='handleDetail(${dataStr})'><i class="fas fa-eye"></i>Detail</button>
                <button class="card-btn edit" onclick='handleEdit(${dataStr})'><i class="fas fa-edit"></i>Edit</button>
                <button class="card-btn deactivate" onclick='handleDeactivate(${dataStr})'><i class="fas fa-user-slash"></i>Non-Aktif</button>
            `;
        } else if (status === 'inactive') {
            buttons = `
                <button class="card-btn reactivate" onclick='handleReactivate(${dataStr})'><i class="fas fa-user-check"></i>Aktifkan</button>
                <button class="card-btn edit" onclick='handleEdit(${dataStr})'><i class="fas fa-edit"></i>Edit</button>
                <button class="card-btn delete" onclick='handleDelete(${dataStr})'><i class="fas fa-trash-alt"></i>Hapus</button>
            `;
        } else if (status === 'rejected') {
            buttons = `
                <button class="card-btn delete" onclick='handleDelete(${dataStr})'><i class="fas fa-trash-alt"></i>Hapus Permanen</button>
            `;
        }
        
        html += `
            <div class="reseller-card status-${status}">
                <div class="card-header">
                    <div class="card-avatar">${initial}</div>
                    <div class="card-info">
                        <div class="card-name">${data.nama || 'Tanpa Nama'}</div>
                        <span class="card-code">${data.resellerCode || '-'}</span>
                    </div>
                    <span class="card-status ${status}">${status}</span>
                </div>
                
                <div class="card-meta">
                    <div class="card-meta-item">
                        <i class="fab fa-whatsapp"></i>
                        <span>${data.wa || '-'}</span>
                    </div>
                    <div class="card-meta-item">
                        <i class="fas fa-envelope"></i>
                        <span>${data.email || '-'}</span>
                    </div>
                    <div class="card-meta-item">
                        <i class="fas fa-university"></i>
                        <span>${data.bank || '-'}</span>
                    </div>
                    <div class="card-meta-item">
                        <i class="fas fa-calendar"></i>
                        <span>${dateStr}</span>
                    </div>
                </div>
                
                <div class="card-actions">${buttons}</div>
            </div>
        `;
    });
    
    grid.innerHTML = html;
}


// Search
document.getElementById('searchInput').addEventListener('input', (e) => {
    searchQuery = e.target.value.trim();
    document.getElementById('searchClear').classList.toggle('show', searchQuery.length > 0);
    applyFilters();
});

function clearSearch() {
    document.getElementById('searchInput').value = '';
    searchQuery = '';
    document.getElementById('searchClear').classList.remove('show');
    applyFilters();
}


// Filter Tabs
document.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentFilter = tab.dataset.status;
        applyFilters();
    });
});


