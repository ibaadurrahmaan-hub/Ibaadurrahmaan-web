/* Mobile */
@media (max-width:640px){
    .card-meta{grid-template-columns:1fr;}
    .card-actions{flex-direction:column;}
    .card-btn{width:100%;}
    .filter-tab{padding:8px 14px;font-size:0.75rem;}
    .nav-item{padding:8px 10px;font-size:0.6rem;min-width:56px;}
