<style>
:root{
    --bg:#050B18;
    --bg-card:#0F1E33;
    --gold:#d4a536;
    --gold-glow:rgba(212,165,54,0.3);
    --text:#fff;
    --text-muted:#8a94a6;
    --border:rgba(255,255,255,0.08);
}

*{margin:0;padding:0;box-sizing:border-box;}

body{
    background:var(--bg);
    color:var(--text);
    font-family:'Poppins',sans-serif;
    min-height:100vh;
    padding-bottom:100px;
    background-image:
        radial-gradient(circle at 10% 10%,rgba(212,165,54,0.08),transparent 40%),
        radial-gradient(circle at 90% 90%,rgba(212,165,54,0.05),transparent 40%);
}


/* ==================== HEADER ==================== */
.page-header{
    background:linear-gradient(135deg,#0F1E33 0%,#050B18 100%);
    padding:24px 20px;
    border-bottom:2px solid var(--gold);
    position:sticky;
    top:0;
    z-index:100;
    backdrop-filter:blur(20px);
}

.header-inner{
    max-width:1200px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    flex-wrap:wrap;
}

.header-left{
    display:flex;
    align-items:center;
    gap:14px;
}

.back-btn{
    width:40px;
    height:40px;
    background:rgba(255,255,255,0.05);
    border:1px solid var(--border);
    color:var(--text);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    transition:all 0.3s;
}

.back-btn:hover{
    background:var(--gold);
    color:var(--bg);
    border-color:var(--gold);
    transform:translateX(-3px);
}

.page-title{
    font-family:'Montserrat',sans-serif;
    font-size:1.3rem;
    font-weight:900;
    background:linear-gradient(135deg,var(--gold),#e8bd52);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    background-clip:text;
    margin-bottom:2px;
}

.page-subtitle{
    color:var(--text-muted);
    font-size:0.75rem;
    text-transform:uppercase;
    letter-spacing:0.5px;
}


/* ==================== MAIN ==================== */
.main{
    max-width:1200px;
    margin:0 auto;
    padding:24px 20px;
}


/* ==================== SEARCH & FILTER ==================== */
.controls{
    background:linear-gradient(145deg,var(--bg-card),#0A1626);
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px;
    margin-bottom:20px;
}

.search-wrapper{
    position:relative;
    margin-bottom:16px;
}

.search-input{
    width:100%;
    background:#0D1829;
    border:1.5px solid rgba(255,255,255,0.08);
    color:var(--text);
    padding:14px 16px 14px 48px;
    border-radius:12px;
    font-family:'Poppins',sans-serif;
    font-size:0.95rem;
    transition:all 0.3s;
}

.search-input:focus{
    outline:none;
    border-color:var(--gold);
    box-shadow:0 0 0 3px rgba(212,165,54,0.1);
    background:#12233d;
}

.search-input::placeholder{
    color:var(--text-muted);
}

.search-icon{
    position:absolute;
    left:16px;
    top:50%;
    transform:translateY(-50%);
    color:var(--gold);
    font-size:1rem;
}

.search-clear{
    position:absolute;
    right:12px;
    top:50%;
    transform:translateY(-50%);
    background:rgba(231,76,60,0.15);
    border:1px solid rgba(231,76,60,0.3);
    color:#e74c3c;
    width:28px;
    height:28px;
    border-radius:50%;
    cursor:pointer;
    display:none;
    align-items:center;
    justify-content:center;
    font-size:0.75rem;
    transition:all 0.2s;
}

.search-clear.show{display:flex;}

.search-clear:hover{
    background:#e74c3c;
    color:#fff;
}


/* Filter Tabs */
.filter-tabs{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding-bottom:4px;
    -ms-overflow-style:none;
    scrollbar-width:none;
}

.filter-tabs::-webkit-scrollbar{display:none;}

.filter-tab{
    padding:10px 18px;
    background:rgba(255,255,255,0.05);
    border:1px solid var(--border);
    color:var(--text-muted);
    border-radius:100px;
    font-size:0.82rem;
    font-weight:600;
    cursor:pointer;
    transition:all 0.3s;
    display:inline-flex;
    align-items:center;
    gap:6px;
    white-space:nowrap;
    font-family:'Poppins',sans-serif;
    flex-shrink:0;
}

.filter-tab:hover{
    background:rgba(212,165,54,0.1);
    color:var(--gold);
    border-color:rgba(212,165,54,0.2);
}

.filter-tab.active{
    background:linear-gradient(135deg,var(--gold),#c19a2e);
    color:var(--bg);
    border-color:var(--gold);
    box-shadow:0 4px 12px var(--gold-glow);
}

.filter-tab .count{
    background:rgba(0,0,0,0.15);
    padding:2px 8px;
    border-radius:100px;
    font-size:0.72rem;
    font-weight:800;
}

.filter-tab:not(.active) .count{
    background:rgba(212,165,54,0.15);
    color:var(--gold);
}


/* ==================== RESULT INFO ==================== */
.result-info{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 4px;
    color:var(--text-muted);
    font-size:0.85rem;
}

.result-count{
    display:flex;
    align-items:center;
    gap:6px;
}

.result-count b{
    color:var(--gold);
    font-weight:800;
}


/* ==================== RESELLER GRID ==================== */
.reseller-grid{
    display:grid;
    gap:12px;
    margin-bottom:24px;
}

.reseller-card{
    background:linear-gradient(145deg,var(--bg-card),#0A1626);
    border:1px solid var(--border);
    border-radius:14px;
    padding:16px;
    transition:all 0.3s;
    position:relative;
    overflow:hidden;
}

.reseller-card:hover{
    border-color:rgba(212,165,54,0.3);
    transform:translateY(-2px);
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.reseller-card.status-pending{border-left:3px solid #f39c12;}
.reseller-card.status-active{border-left:3px solid #25d366;}
.reseller-card.status-inactive{border-left:3px solid #f39c12;}
.reseller-card.status-rejected{border-left:3px solid #e74c3c;}

.card-header{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:12px;
}

.card-avatar{
    width:48px;
    height:48px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--gold),#c19a2e);
    color:var(--bg);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:900;
    font-size:1.1rem;
    flex-shrink:0;
}

.card-info{flex:1;min-width:0;}

.card-name{
    font-weight:700;
    color:var(--text);
    font-size:1rem;
    margin-bottom:4px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.card-code{
    font-family:'Montserrat',monospace;
    background:rgba(212,165,54,0.1);
    color:var(--gold);
    padding:3px 10px;
    border-radius:6px;
    font-size:0.72rem;
    font-weight:700;
    display:inline-block;
}

.card-status{
    padding:5px 12px;
    border-radius:100px;
    font-size:0.7rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.5px;
    flex-shrink:0;
}

.card-status.pending{background:rgba(243,156,18,0.15);color:#f39c12;border:1px solid rgba(243,156,18,0.3);}
.card-status.active{background:rgba(37,211,102,0.15);color:#25d366;border:1px solid rgba(37,211,102,0.3);}
.card-status.inactive{background:rgba(243,156,18,0.15);color:#f39c12;border:1px solid rgba(243,156,18,0.3);}
.card-status.rejected{background:rgba(231,76,60,0.15);color:#e74c3c;border:1px solid rgba(231,76,60,0.3);}

.card-meta{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    padding:12px;
    background:rgba(255,255,255,0.02);
    border-radius:10px;
    margin-bottom:12px;
    font-size:0.78rem;
}

.card-meta-item{
    display:flex;
    align-items:center;
    gap:6px;
    color:var(--text-muted);
    min-width:0;
}

.card-meta-item i{
    color:var(--gold);
    font-size:0.85rem;
    flex-shrink:0;
}

.card-meta-item span{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.card-actions{
    display:flex;
    gap:6px;
    flex-wrap:wrap;
}

.card-btn{
    flex:1;
    min-width:80px;
    padding:8px 12px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-family:'Poppins',sans-serif;
    font-size:0.78rem;
    font-weight:700;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    transition:all 0.2s;
}

.card-btn i{font-size:0.85rem;}

.card-btn.detail{
    background:rgba(52,152,219,0.15);
    color:#3498db;
    border:1px solid rgba(52,152,219,0.3);
}
.card-btn.detail:hover{background:#3498db;color:#fff;}

.card-btn.edit{
    background:rgba(212,165,54,0.15);
    color:#d4a536;
    border:1px solid rgba(212,165,54,0.3);
}
.card-btn.edit:hover{background:#d4a536;color:#050B18;}

.card-btn.approve{
    background:rgba(37,211,102,0.15);
    color:#25d366;
    border:1px solid rgba(37,211,102,0.3);
}
.card-btn.approve:hover{background:#25d366;color:#fff;}

.card-btn.reject{
    background:rgba(231,76,60,0.15);
    color:#e74c3c;
    border:1px solid rgba(231,76,60,0.3);
}
.card-btn.reject:hover{background:#e74c3c;color:#fff;}

.card-btn.deactivate{
    background:rgba(243,156,18,0.15);
    color:#f39c12;
    border:1px solid rgba(243,156,18,0.3);
}
.card-btn.deactivate:hover{background:#f39c12;color:#fff;}

.card-btn.reactivate{
    background:rgba(37,211,102,0.15);
    color:#25d366;
    border:1px solid rgba(37,211,102,0.3);
}
.card-btn.reactivate:hover{background:#25d366;color:#fff;}

.card-btn.delete{
    background:rgba(150,40,27,0.2);
    color:#c0392b;
    border:1px solid rgba(150,40,27,0.4);
}
.card-btn.delete:hover{background:#c0392b;color:#fff;}


/* Empty State */
.empty-state{
    text-align:center;
    padding:60px 20px;
    color:var(--text-muted);
}

.empty-state i{
    font-size:4rem;
    opacity:0.3;
    margin-bottom:16px;
}

.empty-state h3{
    font-family:'Montserrat',sans-serif;
    color:var(--text);
    margin-bottom:8px;
}

.empty-state p{
    font-size:0.9rem;
    line-height:1.6;
}


/* ==================== BOTTOM NAV ==================== */
.bottom-nav{
    position:fixed;
    bottom:16px;
    left:50%;
    transform:translateX(-50%);
    background:rgba(15,30,51,0.95);
    backdrop-filter:blur(20px);
    border:1px solid var(--border);
    border-radius:100px;
    padding:10px 14px;
    display:flex;
    gap:6px;
    z-index:1000;
    box-shadow:0 10px 40px rgba(0,0,0,0.4);
}

.nav-item{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:2px;
    padding:8px 14px;
    color:var(--text-muted);
    text-decoration:none;
    border-radius:100px;
    font-size:0.68rem;
    font-weight:700;
    transition:all 0.3s;
    min-width:64px;
    cursor:pointer;
    background:transparent;
    border:none;
    font-family:'Poppins',sans-serif;
}

.nav-item i{font-size:1.1rem;}

.nav-item.active{
    background:linear-gradient(135deg,var(--gold),#c19a2e);
    color:var(--bg);
    box-shadow:0 4px 12px var(--gold-glow);
}


