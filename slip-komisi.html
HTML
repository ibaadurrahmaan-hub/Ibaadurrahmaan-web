// ====================================================
// SLIP KOMISI GENERATOR
// ====================================================

const daysID = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
const monthsID = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 
                  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

let currentMode = 'monthly';
let closingCount = 0;


// ====================================================
// MODE SWITCHER
// ====================================================
function selectMode(mode) {
    currentMode = mode;
    
    document.querySelectorAll('.slip-mode-card').forEach(card => {
        card.classList.toggle('active', card.dataset.mode === mode);
    });
    
    document.getElementById('cardMonthly').style.display = mode === 'monthly' ? 'block' : 'none';
    document.getElementById('cardSingle').style.display = mode === 'single' ? 'block' : 'none';
    
    updatePreview();
}


// ====================================================
// CLOSING LIST (Monthly Mode)
// ====================================================
function addClosing() {
    closingCount++;
    const list = document.getElementById('closingList');
    
    const item = document.createElement('div');
    item.className = 'slip-closing-item';
    item.dataset.id = closingCount;
    item.innerHTML = `
        <input type="text" placeholder="Nama Client" class="closing-client" oninput="updatePreview()">
        <select class="closing-paket" onchange="updatePreview()">
            <option value="1500000">Hemat - Rp 1.5jt</option>
            <option value="2500000" selected>Reguler - Rp 2.5jt</option>
            <option value="5000000">Premium - Rp 5jt</option>
        </select>
        <button class="slip-closing-remove" onclick="removeClosing(${closingCount})">
            <i class="fas fa-trash"></i>
        </button>
    `;
    
    list.appendChild(item);
    updatePreview();
}

function removeClosing(id) {
    const item = document.querySelector(`.slip-closing-item[data-id="${id}"]`);
    if (item) item.remove();
    updatePreview();
}

function updateAllClosings() {
    updatePreview();
}

function getClosings() {
    const items = document.querySelectorAll('.slip-closing-item');
    return Array.from(items).map((item, i) => ({
        no: i + 1,
        client: item.querySelector('.closing-client').value.trim() || `Client ${i+1}`,
        paket: parseInt(item.querySelector('.closing-paket').value),
        paketName: item.querySelector('.closing-paket option:checked').textContent
    }));
}


// ====================================================
// FORMAT HELPERS
// ====================================================
function formatRp(num) {
    return 'Rp ' + num.toLocaleString('id-ID');
}

function formatDate(dateStr) {
    if (!dateStr) return '-';
    const d = new Date(dateStr);
    return `${d.getDate()} ${monthsID[d.getMonth()]} ${d.getFullYear()}`;
}

function formatPeriode(periodeStr) {
    if (!periodeStr) return '-';
    const [year, month] = periodeStr.split('-');
    return `${monthsID[parseInt(month)-1]} ${year}`;
}

function getTierName(tier) {
    if (tier == 15) return { name: 'SILVER', class: 'tier-silver', bonus: 0 };
    if (tier == 20) return { name: 'GOLD', class: 'tier-gold', bonus: 100000 };
    if (tier == 25) return { name: 'PLATINUM', class: 'tier-platinum', bonus: 200000 };
    return { name: 'SILVER', class: 'tier-silver', bonus: 0 };
}

function generateSlipNo(mode) {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const random = String(Date.now()).slice(-4);
    const prefix = mode === 'monthly' ? 'SKB' : 'SKC'; // Slip Komisi Bulanan/Closing
    return `${prefix}/${y}${m}/${random}`;
}


