<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050B18">
<title>Generator Slip Komisi Reseller | Ibaadurrahmaan Web Designer</title>
<meta name="description" content="Generate slip pembayaran komisi reseller otomatis. Bulanan (tgl 1-5) atau per closing.">
<link rel="icon" type="image/png" href="main-logo.png">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="style.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
/* ====================================================
   💰 SLIP KOMISI STYLES
   ==================================================== */
.slip-page{
    background:var(--bg);
    min-height:100vh;
}

/* Back Button */
.slip-back{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:var(--text-muted);
    text-decoration:none;
    font-size:0.9rem;
    font-weight:600;
    padding:12px 20px;
    background:rgba(5,11,24,0.8);
    backdrop-filter:blur(10px);
    border-radius:100px;
    border:1px solid var(--border);
    position:fixed;
    top:20px;
    left:20px;
    z-index:100;
    transition:all 0.3s var(--ease);
}

.slip-back:hover{
    color:var(--gold);
    border-color:var(--gold);
}


/* Header */
.slip-header{
    background:linear-gradient(135deg,#0F1E33 0%,#050B18 100%);
    padding:120px 20px 60px;
    text-align:center;
    position:relative;
    overflow:hidden;
    border-bottom:2px solid var(--gold);
}

.slip-header::before{
    content:'';
    position:absolute;
    inset:0;
    background:radial-gradient(circle at center,rgba(212,165,54,0.1),transparent 70%);
}

.slip-header-badge{
    display:inline-block;
    padding:8px 20px;
    background:var(--grad-gold-shine);
    color:var(--bg);
    border-radius:100px;
    font-size:0.75rem;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:20px;
    position:relative;
    z-index:2;
}

.slip-header h1{
    font-family:'Montserrat',sans-serif;
    font-size:clamp(1.5rem,4vw,2.5rem);
    font-weight:900;
    color:var(--text);
    margin-bottom:12px;
    position:relative;
    z-index:2;
    line-height:1.2;
}

.slip-header p{
    color:var(--text-muted);
    font-size:1rem;
    position:relative;
    z-index:2;
}


/* Container */
.slip-container{
    max-width:900px;
    margin:0 auto;
    padding:40px 20px 80px;
}


/* Mode Selector */
.slip-mode-selector{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
    margin-bottom:32px;
}

.slip-mode-card{
    background:var(--grad-card);
    border:2px solid var(--border);
    border-radius:var(--radius-lg);
    padding:24px 20px;
    cursor:pointer;
    transition:all 0.3s var(--ease);
    text-align:center;
    position:relative;
}

.slip-mode-card:hover{
    border-color:rgba(212,165,54,0.4);
    transform:translateY(-3px);
}

.slip-mode-card.active{
    border-color:var(--gold);
    background:linear-gradient(135deg,rgba(212,165,54,0.15),rgba(212,165,54,0.05));
    box-shadow:0 6px 20px var(--gold-glow);
}

.slip-mode-card.active::before{
    content:'✓';
    position:absolute;
    top:12px;
    right:12px;
    width:26px;
    height:26px;
    background:var(--grad-gold-shine);
    color:var(--bg);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
    font-size:0.9rem;
}

.slip-mode-icon{
    font-size:2.5rem;
    margin-bottom:12px;
    display:block;
}

.slip-mode-title{
    font-family:'Montserrat',sans-serif;
    font-size:1.05rem;
    font-weight:800;
    color:var(--text);
    margin-bottom:6px;
}

.slip-mode-card.active .slip-mode-title{
    color:var(--gold);
}

.slip-mode-desc{
    color:var(--text-muted);
    font-size:0.82rem;
    line-height:1.5;
}


/* Form Card */
.slip-form-card{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:32px;
    margin-bottom:24px;
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.slip-form-title{
    font-family:'Montserrat',sans-serif;
    font-size:1.2rem;
    font-weight:800;
    color:var(--gold);
    margin-bottom:24px;
    display:flex;
    align-items:center;
    gap:12px;
    padding-bottom:16px;
    border-bottom:1px solid var(--border);
}

.slip-form-title i{
    font-size:1.3rem;
}


/* Form Grid */
.slip-form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.slip-form-group{
    display:flex;
    flex-direction:column;
    gap:8px;
}

.slip-form-group.full{
    grid-column:1 / -1;
}

.slip-form-label{
    color:var(--gold);
    font-size:0.88rem;
    font-weight:700;
    display:flex;
    align-items:center;
    gap:8px;
}

.slip-form-label i{
    font-size:0.9rem;
    opacity:0.8;
    width:16px;
}

.slip-form-input,
.slip-form-select{
    background:#0D1829;
    border:1px solid rgba(255,255,255,0.08);
    color:var(--text);
    padding:14px 16px;
    border-radius:10px;
    font-size:0.95rem;
    font-family:'Poppins',sans-serif;
    transition:all 0.3s var(--ease);
    width:100%;
    box-sizing:border-box;
}

.slip-form-input:focus,
.slip-form-select:focus{
    outline:none;
    background:#12233d;
    border-color:var(--gold);
    box-shadow:0 0 0 3px rgba(212,165,54,0.1);
}


/* Closing List (untuk mode bulanan) */
.slip-closing-list{
    display:flex;
    flex-direction:column;
    gap:12px;
    margin-top:12px;
}

.slip-closing-item{
    background:#0D1829;
    border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;
    padding:16px;
    display:grid;
    grid-template-columns:1fr 1fr auto;
    gap:12px;
    align-items:center;
    transition:all 0.3s var(--ease);
}

.slip-closing-item:hover{
    border-color:rgba(212,165,54,0.3);
}

.slip-closing-item input,
.slip-closing-item select{
    background:#12233d;
    border:1px solid transparent;
    color:var(--text);
    padding:10px 12px;
    border-radius:8px;
    font-size:0.9rem;
    font-family:'Poppins',sans-serif;
    width:100%;
    box-sizing:border-box;
}

.slip-closing-item input:focus,
.slip-closing-item select:focus{
    outline:none;
    border-color:var(--gold);
}

.slip-closing-remove{
    background:rgba(231,76,60,0.15);
    border:1px solid rgba(231,76,60,0.3);
    color:#e74c3c;
    width:40px;
    height:40px;
    border-radius:50%;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:all 0.3s var(--ease);
    font-size:1rem;
}

.slip-closing-remove:hover{
    background:#e74c3c;
    color:#fff;
    transform:scale(1.1);
}

.slip-btn-add{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    width:100%;
    padding:14px;
    background:rgba(212,165,54,0.08);
    border:2px dashed rgba(212,165,54,0.3);
    border-radius:10px;
    color:var(--gold);
    font-size:0.9rem;
    font-weight:700;
    cursor:pointer;
    margin-top:12px;
    transition:all 0.3s var(--ease);
}

.slip-btn-add:hover{
    background:rgba(212,165,54,0.15);
    border-color:var(--gold);
    border-style:solid;
}


/* Preview Section */
.slip-preview-wrapper{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:24px;
    margin-top:24px;
}

.slip-preview-title{
    font-family:'Montserrat',sans-serif;
    font-size:1.2rem;
    font-weight:800;
    color:var(--gold);
    margin-bottom:16px;
    display:flex;
    align-items:center;
    gap:12px;
    padding-bottom:16px;
    border-bottom:1px solid var(--border);
}


/* SLIP PREVIEW - White paper look */
.slip-preview{
    background:#fff;
    border-radius:12px;
    padding:40px;
    color:#333;
    font-family:'Poppins',sans-serif;
    box-shadow:0 20px 60px rgba(0,0,0,0.3);
    max-width:100%;
    overflow-x:auto;
}

/* Slip Header */
.slip-doc-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    padding-bottom:20px;
    border-bottom:3px double #d4a536;
    margin-bottom:24px;
    flex-wrap:wrap;
    gap:16px;
}

.slip-brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.slip-brand-logo{
    width:50px;
    height:50px;
    background:linear-gradient(135deg,#d4a536,#c19a2e);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:1.5rem;
    font-weight:900;
    flex-shrink:0;
}

.slip-brand-text h2{
    font-family:'Montserrat',sans-serif;
    font-size:1.2rem;
    font-weight:900;
    color:#333;
    margin:0 0 2px;
}

.slip-brand-text p{
    font-size:0.75rem;
    color:#888;
    margin:0;
    letter-spacing:1px;
}

.slip-doc-info{
    text-align:right;
}

.slip-doc-info h3{
    font-family:'Montserrat',sans-serif;
    font-size:1.15rem;
    font-weight:900;
    color:#d4a536;
    margin:0 0 4px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.slip-doc-info p{
    font-size:0.8rem;
    color:#666;
    margin:2px 0;
}

.slip-doc-info .slip-no{
    font-family:'Montserrat',monospace;
    font-weight:700;
    color:#333;
}


/* Party Info */
.slip-parties{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-bottom:24px;
}

.slip-party{
    background:#faf5e6;
    border-left:4px solid #d4a536;
    padding:14px 16px;
    border-radius:0 8px 8px 0;
}

.slip-party.reseller{
    background:#e6f9ee;
    border-left-color:#25d366;
}

.slip-party-label{
    font-size:0.68rem;
    font-weight:800;
    color:#d4a536;
    text-transform:uppercase;
    letter-spacing:1.5px;
    margin-bottom:8px;
}

.slip-party.reseller .slip-party-label{
    color:#128c7e;
}

.slip-party-name{
    font-family:'Montserrat',sans-serif;
    font-size:1rem;
    font-weight:800;
    color:#333;
    margin-bottom:4px;
}

.slip-party-detail{
    font-size:0.78rem;
    color:#666;
    line-height:1.5;
}


/* Detail Table */
.slip-detail-title{
    font-family:'Montserrat',sans-serif;
    font-size:0.9rem;
    font-weight:800;
    color:#333;
    margin:20px 0 10px;
    padding-bottom:6px;
    border-bottom:2px solid #d4a536;
    text-transform:uppercase;
    letter-spacing:1px;
}

.slip-table{
    width:100%;
    border-collapse:collapse;
    margin-bottom:20px;
    font-size:0.85rem;
}

.slip-table th{
    background:#faf5e6;
    color:#d4a536;
    padding:10px 12px;
    text-align:left;
    font-weight:800;
    font-size:0.75rem;
    text-transform:uppercase;
    letter-spacing:1px;
    border-bottom:2px solid #d4a536;
}

.slip-table th.center{text-align:center;}
.slip-table th.right{text-align:right;}

.slip-table td{
    padding:12px;
    border-bottom:1px solid #eee;
    color:#333;
    vertical-align:top;
}

.slip-table td.center{text-align:center;}
.slip-table td.right{text-align:right;font-family:'Montserrat',monospace;font-weight:600;}

.slip-table tr:hover td{
    background:#fdfaf0;
}

.slip-table .tier-badge{
    display:inline-block;
    padding:3px 8px;
    border-radius:100px;
    font-size:0.7rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:0.5px;
}

.slip-table .tier-silver{background:#e8e8e8;color:#666;}
.slip-table .tier-gold{background:#faf5e6;color:#d4a536;}
.slip-table .tier-platinum{background:#e6f0fa;color:#3d6fb5;}


/* Summary */
.slip-summary{
    background:#faf5e6;
    border-radius:10px;
    padding:20px;
    margin-bottom:20px;
}

.slip-summary-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:8px 0;
    border-bottom:1px dashed rgba(212,165,54,0.2);
    font-size:0.9rem;
    color:#555;
}

.slip-summary-row:last-child{
    border-bottom:none;
}

.slip-summary-row .label{
    color:#666;
    font-weight:500;
}

.slip-summary-row .value{
    font-family:'Montserrat',monospace;
    font-weight:700;
    color:#333;
}

.slip-summary-total{
    background:linear-gradient(135deg,#d4a536,#c19a2e);
    color:#fff;
    padding:16px 20px;
    border-radius:10px;
    margin-top:12px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 4px 15px rgba(212,165,54,0.3);
}

.slip-summary-total .label{
    font-size:0.85rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:1px;
    opacity:0.9;
}

.slip-summary-total .value{
    font-family:'Montserrat',sans-serif;
    font-size:1.5rem;
    font-weight:900;
}


/* Payment Info */
.slip-payment{
    background:#e6f9ee;
    border-left:4px solid #25d366;
    padding:16px;
    border-radius:0 8px 8px 0;
    margin-bottom:20px;
}

.slip-payment-title{
    font-weight:800;
    color:#128c7e;
    font-size:0.85rem;
    margin-bottom:8px;
    text-transform:uppercase;
    letter-spacing:1px;
    display:flex;
    align-items:center;
    gap:8px;
}

.slip-payment-detail{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px 16px;
    font-size:0.85rem;
    color:#333;
}

.slip-payment-detail strong{
    color:#128c7e;
    display:block;
    font-size:0.72rem;
    text-transform:uppercase;
    letter-spacing:0.5px;
    margin-bottom:2px;
}


/* Footer */
.slip-footer{
    margin-top:24px;
    padding-top:20px;
    border-top:2px solid #eee;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    flex-wrap:wrap;
}

.slip-footer-info{
    flex:1;
    font-size:0.75rem;
    color:#666;
    line-height:1.5;
}

.slip-footer-info strong{
    color:#333;
}

.slip-stamp{
    text-align:center;
    padding:16px;
    border:2px dashed #d4a536;
    border-radius:8px;
    color:#d4a536;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1px;
    font-size:0.75rem;
    background:rgba(212,165,54,0.05);
    min-width:140px;
}

.slip-stamp i{
    font-size:1.5rem;
    display:block;
    margin-bottom:4px;
}

.slip-stamp.paid{
    border-color:#25d366;
    color:#128c7e;
    background:rgba(37,211,102,0.08);
}


/* Actions */
.slip-actions{
    display:flex;
    gap:12px;
    justify-content:center;
    flex-wrap:wrap;
    margin-top:32px;
    padding:0 20px;
}

.slip-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    padding:16px 32px;
    border-radius:100px;
    font-size:1rem;
    font-weight:700;
    text-decoration:none;
    cursor:pointer;
    transition:all 0.3s var(--ease);
    border:none;
    min-width:180px;
    line-height:1;
    font-family:'Poppins',sans-serif;
}

.slip-btn i{font-size:1.2rem;}

.slip-btn-primary{
    background:var(--grad-gold-shine);
    color:var(--bg);
    box-shadow:0 6px 20px var(--gold-glow);
}

.slip-btn-primary:hover:not(:disabled){
    transform:translateY(-3px);
    box-shadow:0 8px 30px var(--gold-glow);
}

.slip-btn-primary:disabled{
    opacity:0.4;
    cursor:not-allowed;
}

.slip-btn-wa{
    background:#25D366;
    color:#fff;
    box-shadow:0 6px 20px rgba(37,211,102,0.3);
}

.slip-btn-wa:hover{
    background:#20BA5A;
    transform:translateY(-3px);
}

.slip-btn-secondary{
    background:rgba(255,255,255,0.05);
    color:var(--text);
    border:1px solid var(--border);
}

.slip-btn-secondary:hover{
    background:rgba(255,255,255,0.1);
    border-color:var(--gold);
    color:var(--gold);
    transform:translateY(-3px);
}


/* Responsive */
@media (max-width:768px){
    .slip-header{padding:100px 20px 40px;}
    
    .slip-mode-selector{grid-template-columns:1fr;}
    
    .slip-form-card{padding:24px 20px;}
    .slip-form-grid{grid-template-columns:1fr;gap:16px;}
    
    .slip-preview{padding:24px 20px;}
    
    .slip-doc-header{
        flex-direction:column;
        text-align:center;
    }
    
    .slip-doc-info{text-align:center;}
    
    .slip-parties{grid-template-columns:1fr;gap:12px;}
    
    .slip-table{font-size:0.75rem;}
    .slip-table th,
    .slip-table td{padding:8px 6px;}
    
    .slip-closing-item{
        grid-template-columns:1fr;
        gap:8px;
    }
    
    .slip-summary-total .value{font-size:1.2rem;}
    
    .slip-payment-detail{grid-template-columns:1fr;}
    
    .slip-footer{
        flex-direction:column;
        text-align:center;
    }
    
    .slip-actions{flex-direction:column;}
    .slip-btn{width:100%;}
    
    .slip-back{
        top:12px;
        left:12px;
        padding:10px 16px;
        font-size:0.8rem;
    }
}
</style>
</head>
<body class="slip-page">

<!-- Back Button -->
<a href="reseller.html" class="slip-back">
    <i class="fas fa-arrow-left"></i>
    <span>Kembali</span>
</a>

<!-- Header -->
<header class="slip-header">
    <div class="slip-header-badge">💰 SLIP KOMISI</div>
    <h1>Generator Slip<br>Pembayaran Komisi</h1>
    <p>Bulanan (tgl 1-5) atau langsung per closing</p>
</header>

<!-- Container -->
<div class="slip-container">

    <!-- Mode Selector -->
    <div class="slip-mode-selector">
        <div class="slip-mode-card active" data-mode="monthly" onclick="selectMode('monthly')">
            <span class="slip-mode-icon">📅</span>
            <div class="slip-mode-title">Pembayaran Bulanan</div>
            <div class="slip-mode-desc">Rekap komisi 1 bulan penuh (tgl 1-5 bulan berikutnya)</div>
        </div>
        <div class="slip-mode-card" data-mode="single" onclick="selectMode('single')">
            <span class="slip-mode-icon">⚡</span>
            <div class="slip-mode-title">Per Closing</div>
            <div class="slip-mode-desc">Slip langsung untuk 1 closing (dibayar segera)</div>
        </div>
    </div>


    <!-- Form Data Reseller -->
    <div class="slip-form-card">
        <div class="slip-form-title">
            <i class="fas fa-user-circle"></i>
            <span>Data Reseller</span>
        </div>
        
        <div class="slip-form-grid">
            <div class="slip-form-group full">
                <label class="slip-form-label">
                    <i class="fas fa-user"></i> Nama Reseller
                </label>
                <input type="text" class="slip-form-input" id="fieldNama" placeholder="Nama lengkap reseller">
            </div>
            
            <div class="slip-form-group">
                <label class="slip-form-label">
                    <i class="fas fa-id-badge"></i> Kode Reseller
                </label>
                <input type="text" class="slip-form-input" id="fieldKode" placeholder="RSL-001">
            </div>
            
            <div class="slip-form-group">
                <label class="slip-form-label">
                    <i class="fas fa-medal"></i> Tier Reseller
                </label>
                <select class="slip-form-select" id="fieldTier" onchange="updateAllClosings()">
