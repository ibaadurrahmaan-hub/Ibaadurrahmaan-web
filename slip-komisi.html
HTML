    document.getElementById('singleTglBayar').value = today;
    
    // Add first closing
    addClosing();
    
    // Listen to all inputs
    document.querySelectorAll('.slip-form-input, .slip-form-select').forEach(input => {
        input.addEventListener('input', updatePreview);
        input.addEventListener('change', updatePreview);
    });
});
</script>

