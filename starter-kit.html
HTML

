<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050B18">
<title>Starter Kit Reseller | Ibaadurrahmaan Web Designer</title>
<meta name="description" content="Panduan lengkap, materi promosi, dan strategi closing untuk reseller Ibaadurrahmaan Web Designer.">
<link rel="icon" type="image/png" href="main-logo.png">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="style.css">

<style>
/* ====================================================
   📦 STARTER KIT - PREMIUM STYLES
   ==================================================== */
.kit-page{
    background:var(--bg);
    min-height:100vh;
}


/* ============================================
   BACK BUTTON
   ============================================ */
.kit-back{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:var(--text-muted);
    text-decoration:none;
    font-size:0.9rem;
    font-weight:600;
    padding:12px 20px;
    background:rgba(5,11,24,0.8);
    backdrop-filter:blur(10px);
    border-radius:100px;
    border:1px solid var(--border);
    position:fixed;
    top:20px;
    left:20px;
    z-index:100;
    transition:all 0.3s var(--ease);
}

.kit-back:hover{
    color:var(--gold);
    border-color:var(--gold);
}


/* ============================================
   HERO HEADER
   ============================================ */
.kit-hero{
    background:linear-gradient(180deg,#0F1E33 0%,#050B18 60%,var(--bg) 100%);
    padding:140px 20px 80px;
    text-align:center;
    position:relative;
    overflow:hidden;
}

.kit-hero::before{
    content:'';
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at 30% 20%,rgba(212,165,54,0.15),transparent 50%),
        radial-gradient(circle at 70% 80%,rgba(37,211,102,0.08),transparent 50%);
}

.kit-hero::after{
    content:'';
    position:absolute;
    top:-100px;
    left:50%;
    transform:translateX(-50%);
    width:600px;
    height:600px;
    background:radial-gradient(circle,rgba(212,165,54,0.08),transparent 70%);
    pointer-events:none;
}

.kit-hero-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 24px;
    background:rgba(212,165,54,0.15);
    border:1px solid rgba(212,165,54,0.3);
    border-radius:100px;
    font-size:0.78rem;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:24px;
    position:relative;
    z-index:2;
    color:var(--gold);
}

.kit-hero-badge i{
    font-size:1rem;
}

.kit-hero h1{
    font-family:'Montserrat',sans-serif;
    font-size:clamp(2rem,5vw,3.5rem);
    font-weight:900;
    color:var(--text);
    margin-bottom:16px;
    position:relative;
    z-index:2;
    line-height:1.15;
    letter-spacing:-1px;
}

.kit-hero .text-gold{
    background:var(--grad-gold-shine);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    filter:drop-shadow(0 4px 15px rgba(212,165,54,0.4));
}

.kit-hero-sub{
    color:var(--text-muted);
    font-size:1.1rem;
    max-width:600px;
    margin:0 auto 40px;
    line-height:1.7;
    position:relative;
    z-index:2;
}

/* Hero Stats */
.kit-hero-stats{
    display:flex;
    justify-content:center;
    gap:32px;
    flex-wrap:wrap;
    position:relative;
    z-index:2;
}

.kit-hero-stat{
    text-align:center;
}

.kit-hero-stat-num{
    font-family:'Montserrat',sans-serif;
    font-size:2rem;
    font-weight:900;
    color:var(--gold);
    line-height:1;
    margin-bottom:4px;
}

.kit-hero-stat-label{
    color:var(--text-dim);
    font-size:0.8rem;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:1px;
}


/* ============================================
   SECTION WRAPPER
   ============================================ */
.kit-section{
    padding:80px 20px;
    position:relative;
}

.kit-section.alt{
    background:linear-gradient(180deg,rgba(15,30,51,0.5) 0%,var(--bg) 100%);
}

.kit-container{
    max-width:1100px;
    margin:0 auto;
}


/* Section Header */
.kit-section-header{
    text-align:center;
    margin-bottom:48px;
}

.kit-section-badge{
    display:inline-block;
    padding:6px 16px;
    background:rgba(212,165,54,0.12);
    border:1px solid rgba(212,165,54,0.25);
    border-radius:100px;
    font-size:0.72rem;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:16px;
}

.kit-section-title{
    font-family:'Montserrat',sans-serif;
    font-size:clamp(1.5rem,3.5vw,2.5rem);
    font-weight:900;
    color:var(--text);
    line-height:1.2;
    margin-bottom:12px;
}

.kit-section-sub{
    color:var(--text-muted);
    font-size:1rem;
    max-width:600px;
    margin:0 auto;
    line-height:1.6;
}


/* ============================================
   📚 LEARNING PATH (Roadmap Timeline)
   ============================================ */
.kit-roadmap{
    position:relative;
    max-width:800px;
    margin:0 auto;
    padding-left:40px;
}

.kit-roadmap::before{
    content:'';
    position:absolute;
    left:19px;
    top:0;
    bottom:0;
    width:2px;
    background:linear-gradient(180deg,var(--gold),rgba(212,165,54,0.1));
}

.kit-roadmap-step{
    position:relative;
    margin-bottom:40px;
    padding-left:40px;
}

.kit-roadmap-step:last-child{
    margin-bottom:0;
}

.kit-roadmap-dot{
    position:absolute;
    left:-21px;
    top:0;
    width:40px;
    height:40px;
    background:var(--grad-gold-shine);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--bg);
    font-weight:900;
    font-family:'Montserrat',sans-serif;
    font-size:0.9rem;
    box-shadow:0 4px 15px var(--gold-glow);
    z-index:2;
}

.kit-roadmap-card{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:28px;
    transition:all 0.4s var(--ease);
}

.kit-roadmap-card:hover{
    border-color:rgba(212,165,54,0.4);
    transform:translateY(-4px);
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.kit-roadmap-badge{
    display:inline-block;
    padding:4px 10px;
    border-radius:100px;
    font-size:0.68rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1px;
    margin-bottom:12px;
}

.kit-roadmap-badge.beginner{
    background:rgba(37,211,102,0.15);
    color:#25D366;
    border:1px solid rgba(37,211,102,0.3);
}

.kit-roadmap-badge.intermediate{
    background:rgba(212,165,54,0.15);
    color:var(--gold);
    border:1px solid rgba(212,165,54,0.3);
}

.kit-roadmap-badge.advanced{
    background:rgba(147,51,234,0.15);
    color:#9333ea;
    border:1px solid rgba(147,51,234,0.3);
}

.kit-roadmap-title{
    font-family:'Montserrat',sans-serif;
    font-size:1.2rem;
    font-weight:800;
    color:var(--text);
    margin-bottom:8px;
}

.kit-roadmap-desc{
    color:var(--text-muted);
    font-size:0.92rem;
    line-height:1.7;
    margin-bottom:16px;
}

.kit-roadmap-checklist{
    list-style:none;
    padding:0;
    margin:0;
    display:flex;
    flex-direction:column;
    gap:8px;
}

.kit-roadmap-checklist li{
    display:flex;
    align-items:flex-start;
    gap:10px;
    color:var(--text-muted);
    font-size:0.88rem;
    line-height:1.5;
}

.kit-roadmap-checklist li i{
    color:var(--gold);
    font-size:0.85rem;
    margin-top:3px;
    flex-shrink:0;
}


/* ============================================
   🎯 KNOWLEDGE CARDS (Materi Pembelajaran)
   ============================================ */
.kit-knowledge-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
}

.kit-knowledge-card{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    overflow:hidden;
    transition:all 0.4s var(--ease);
    position:relative;
    display:flex;
    flex-direction:column;
}

.kit-knowledge-card:hover{
    border-color:rgba(212,165,54,0.4);
    transform:translateY(-6px);
    box-shadow:0 15px 40px rgba(0,0,0,0.3);
}

.kit-knowledge-header{
    padding:28px 24px 20px;
    position:relative;
}

.kit-knowledge-icon{
    width:56px;
    height:56px;
    background:var(--grad-gold-shine);
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:1.5rem;
    color:var(--bg);
    margin-bottom:16px;
    box-shadow:0 6px 20px var(--gold-glow);
}

.kit-knowledge-tag{
    position:absolute;
    top:20px;
    right:20px;
    padding:4px 10px;
    border-radius:100px;
    font-size:0.65rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1px;
    background:rgba(37,211,102,0.15);
    color:#25D366;
    border:1px solid rgba(37,211,102,0.3);
}

.kit-knowledge-tag.important{
    background:rgba(231,76,60,0.15);
    color:#e74c3c;
    border-color:rgba(231,76,60,0.3);
}

.kit-knowledge-tag.premium{
    background:rgba(212,165,54,0.15);
    color:var(--gold);
    border-color:rgba(212,165,54,0.3);
}

.kit-knowledge-title{
    font-family:'Montserrat',sans-serif;
    font-size:1.15rem;
    font-weight:800;
    color:var(--text);
    margin-bottom:8px;
    line-height:1.3;
}

.kit-knowledge-body{
    padding:0 24px 24px;
    flex:1;
    display:flex;
    flex-direction:column;
}

.kit-knowledge-desc{
    color:var(--text-muted);
    font-size:0.88rem;
    line-height:1.7;
    margin-bottom:16px;
    flex:1;
}

.kit-knowledge-topics{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-bottom:20px;
}

.kit-knowledge-topic{
    padding:4px 10px;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:100px;
    font-size:0.72rem;
    color:var(--text-dim);
    font-weight:600;
}

.kit-knowledge-footer{
    padding-top:16px;
    border-top:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.kit-knowledge-time{
    display:flex;
    align-items:center;
    gap:6px;
    color:var(--text-dim);
    font-size:0.78rem;
}

.kit-knowledge-time i{
    color:var(--gold);
    font-size:0.85rem;
}


/* ============================================
   💎 TIER BENEFITS COMPARISON
   ============================================ */
.kit-tier-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-bottom:40px;
}

.kit-tier-card{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:28px 24px;
    text-align:center;
    transition:all 0.4s var(--ease);
    position:relative;
    overflow:hidden;
}

.kit-tier-card:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.kit-tier-card.featured{
    border-color:var(--gold);
    background:linear-gradient(180deg,rgba(212,165,54,0.12),rgba(212,165,54,0.02));
    box-shadow:0 0 40px rgba(212,165,54,0.15);
}

.kit-tier-card.featured::before{
    content:'⭐ POPULER';
    position:absolute;
    top:0;
    left:0;
    right:0;
    padding:6px;
    background:var(--grad-gold-shine);
    color:var(--bg);
    font-size:0.68rem;
    font-weight:800;
    letter-spacing:2px;
    text-align:center;
}

.kit-tier-card.featured{
    padding-top:44px;
}

.kit-tier-emoji{
    font-size:3rem;
    margin-bottom:12px;
    display:block;
    filter:drop-shadow(0 4px 12px rgba(212,165,54,0.3));
}

.kit-tier-name{
    font-family:'Montserrat',sans-serif;
    font-size:1.3rem;
    font-weight:900;
    color:var(--gold);
    letter-spacing:3px;
    margin-bottom:8px;
}

.kit-tier-commission{
    font-family:'Montserrat',sans-serif;
    font-size:2.5rem;
    font-weight:900;
    background:var(--grad-gold-shine);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    line-height:1;
    margin-bottom:6px;
}

.kit-tier-req{
    color:var(--text-dim);
    font-size:0.85rem;
    margin-bottom:20px;
}

.kit-tier-list{
    list-style:none;
    padding:16px 0 0;
    border-top:1px solid var(--border);
    text-align:left;
    margin:0;
}

.kit-tier-list li{
    padding:8px 0;
    color:var(--text-muted);
    font-size:0.88rem;
    display:flex;
    align-items:flex-start;
    gap:8px;
}

.kit-tier-list li i{
    color:var(--gold);
    font-size:0.8rem;
    margin-top:3px;
    flex-shrink:0;
}


/* ============================================
   📝 SCRIPT TEMPLATES
   ============================================ */
.kit-script-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:24px;
}

.kit-script-card{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    overflow:hidden;
    transition:all 0.4s var(--ease);
}

.kit-script-card:hover{
    border-color:rgba(212,165,54,0.4);
    transform:translateY(-4px);
    box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

.kit-script-header{
    padding:20px 24px;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    gap:12px;
}

.kit-script-icon{
    width:40px;
    height:40px;
    background:rgba(212,165,54,0.15);
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--gold);
    font-size:1.1rem;
    flex-shrink:0;
}

.kit-script-title{
    font-family:'Montserrat',sans-serif;
    font-size:1rem;
    font-weight:800;
    color:var(--text);
}

.kit-script-body{
    padding:20px 24px;
}

.kit-script-text{
    background:#0D1829;
    border:1px solid rgba(255,255,255,0.06);
    border-radius:10px;
    padding:16px 18px;
    color:var(--text-muted);
    font-size:0.88rem;
    line-height:1.8;
    position:relative;
    font-style:italic;
}

.kit-script-text::before{
    content:'"';
    position:absolute;
    top:8px;
    left:12px;
    font-size:2rem;
    color:var(--gold);
    opacity:0.3;
    font-family:serif;
    line-height:1;
}

.kit-script-text strong{
    color:var(--gold);
    font-style:normal;
}

.kit-script-actions{
    padding:12px 24px 20px;
    display:flex;
    gap:8px;
}

.kit-copy-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 16px;
    background:rgba(212,165,54,0.1);
    border:1px solid rgba(212,165,54,0.3);
    border-radius:100px;
    color:var(--gold);
    font-size:0.8rem;
    font-weight:700;
    cursor:pointer;
    transition:all 0.3s var(--ease);
}

.kit-copy-btn:hover{
    background:rgba(212,165,54,0.2);
    border-color:var(--gold);
    transform:translateY(-1px);
}

.kit-copy-btn.copied{
    background:rgba(37,211,102,0.15);
    border-color:#25D366;
    color:#25D366;
}


/* ============================================
   ❓ FAQ ACCORDION
   ============================================ */
.kit-faq-list{
    max-width:800px;
    margin:0 auto;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.kit-faq-item{
    background:var(--grad-card);
    border:1px solid var(--border);
    border-radius:var(--radius-md);
    overflow:hidden;
    transition:all 0.3s var(--ease);
}

.kit-faq-item.active{
    border-color:rgba(212,165,54,0.3);
}

.kit-faq-q{
    display:flex;
    align-items:center;
    gap:14px;
    width:100%;
    padding:18px 20px;
    background:transparent;
    border:none;
    color:var(--text);
    font-size:0.95rem;
    font-weight:600;
    text-align:left;
    cursor:pointer;
    transition:all 0.3s var(--ease);
    font-family:'Poppins',sans-serif;
}

.kit-faq-q:hover{
    background:rgba(212,165,54,0.05);
}

.kit-faq-q i{
    color:var(--gold);
    font-size:0.85rem;
    transition:transform 0.3s var(--ease);
    flex-shrink:0;
    margin-left:auto;
}

.kit-faq-item.active .kit-faq-q i{
    transform:rotate(45deg);
}

.kit-faq-a{
    max-height:0;
    overflow:hidden;
    transition:max-height 0.4s var(--ease);
}

.kit-faq-item.active .kit-faq-a{
    max-height:500px;
}

.kit-faq-a p{
    padding:0 20px 18px;
    color:var(--text-muted);
    font-size:0.9rem;
    line-height:1.7;
    margin:0;
}


/* ============================================
   🎯 CTA FINAL
   ============================================ */
.kit-cta{
    text-align:center;
    padding:80px 20px;
    background:linear-gradient(180deg,var(--bg) 0%,#0F1E33 100%);
    position:relative;
    overflow:hidden;
}

.kit-cta::before{
    content:'';
    position:absolute;
    inset:0;
    background:radial-gradient(circle at center,rgba(212,165,54,0.1),transparent 60%);
}

.kit-cta-box{
    background:var(--grad-card);
    border:2px solid var(--gold);
    border-radius:var(--radius-xl);
    padding:48px 32px;
    max-width:700px;
    margin:0 auto;
    box-shadow:0 20px 60px rgba(212,165,54,0.15);
    position:relative;
    z-index:2;
}

.kit-cta-box h2{
    font-family:'Montserrat',sans-serif;
    font-size:clamp(1.5rem,3vw,2.2rem);
    font-weight:900;
    color:var(--text);
    margin-bottom:16px;
    line-height:1.2;
}

.kit-cta-box p{
    color:var(--text-muted);
    font-size:1rem;
    margin-bottom:32px;
    line-height:1.6;
}

.kit-cta-buttons{
    display:flex;
    gap:12px;
    justify-content:center;
    flex-wrap:wrap;
}

.kit-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    padding:16px 32px;
    border-radius:100px;
    font-size:1rem;
    font-weight:700;
    text-decoration:none;
    cursor:pointer;
    transition:all 0.3s var(--ease);
    border:none;
    line-height:1;
    font-family:'Poppins',sans-serif;
}

.kit-btn i{font-size:1.2rem;}

.kit-btn-primary{
    background:var(--grad-gold-shine);
    color:var(--bg);
    box-shadow:0 6px 20px var(--gold-glow);
}

.kit-btn-primary:hover{
    transform:translateY(-3px);
    box-shadow:0 8px 30px var(--gold-glow);
}

.kit-btn-wa{
    background:#25D366;
    color:#fff;
    box-shadow:0 6px 20px rgba(37,211,102,0.3);
}

.kit-btn-wa:hover{
    background:#20BA5A;
    transform:translateY(-3px);
}

.kit-btn-secondary{
    background:rgba(255,255,255,0.05);
    color:var(--text);
    border:1px solid var(--border);
}

.kit-btn-secondary:hover{
    border-color:var(--gold);
    color:var(--gold);
    transform:translateY(-3px);
}


/* ============================================
   📱 RESPONSIVE
   ============================================ */
@media (max-width:992px){
    .kit-knowledge-grid{
        grid-template-columns:repeat(2,1fr);
    }
    .kit-tier-grid{
        grid-template-columns:repeat(2,1fr);
    }
    .kit-tier-card.featured{
        grid-column:1 / -1;
        max-width:400px;
        margin:0 auto;
    }
}

@media (max-width:768px){
    .kit-hero{padding:120px 20px 60px;}
    .kit-section{padding:60px 20px;}

    .kit-knowledge-grid,
    .kit-script-grid{
        grid-template-columns:1fr;
    }

    .kit-tier-grid{
        grid-template-columns:1fr;
    }

    .kit-tier-card.featured{
        max-width:100%;
    }

